---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactForm from '../../components/forms/ContactForm.astro';
import { t } from '../../i18n/utils';

const lang = 'fr' as const;
---

<PageLayout
  title={t(lang, 'contact.page-title')}
  description={t(lang, 'contact.meta-description')}
  lang={lang}
>
  <div class="contact-page">
    <div class="contact-container">

      <!-- Left: info -->
      <div class="contact-info">
        <p class="contact-eyebrow">— KechBnb —</p>
        <h1 class="contact-heading">{t(lang, 'contact.headline')}</h1>
        <div class="contact-rule" aria-hidden="true"></div>
        <p class="contact-intro">
          Parlez-nous de votre bien à Marrakech. Nous vous répondrons sous 24 heures avec une estimation personnalisée — sans engagement.
        </p>

        <!-- Contact details -->
        <ul class="contact-details" aria-label="Coordonnées">
          <li class="contact-detail-item">
            <span class="detail-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 6.75Z" />
              </svg>
            </span>
            <a href={`tel:${t(lang, 'contact.phone').replace(/\s/g,'')}`} class="detail-link">
              {t(lang, 'contact.phone')}
            </a>
          </li>
          <li class="contact-detail-item">
            <span class="detail-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
            </span>
            <a href={`mailto:${t(lang, 'contact.email')}`} class="detail-link">
              {t(lang, 'contact.email')}
            </a>
          </li>
          <li class="contact-detail-item">
            <span class="detail-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
            </span>
            <span>{t(lang, 'contact.address')}</span>
          </li>
        </ul>

        <!-- Commission reminder -->
        <div class="commission-callout">
          <strong>Commission de 20% tout inclus</strong>
          <p>Pas de frais d'installation, pas de frais cachés. Vous payez uniquement lorsque votre bien est réservé.</p>
        </div>
      </div>

      <!-- Right: form -->
      <div class="contact-form-wrap">
        <ContactForm lang={lang} />
      </div>

    </div>
  </div>
</PageLayout>

<style>
  .contact-page {
    background: var(--color-offwhite);
    padding: 4rem 1.25rem 5rem;
    min-height: 60vh;
  }

  .contact-container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 768px) {
    .contact-container {
      grid-template-columns: 1fr 1.4fr;
      gap: 4rem;
      align-items: start;
    }
  }

  /* Info column */
  .contact-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0 0 1rem;
  }

  .contact-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 1rem;
  }

  .contact-rule {
    width: 3rem;
    height: 2px;
    background: linear-gradient(90deg, var(--color-gold), transparent);
    margin-bottom: 1.25rem;
  }

  .contact-intro {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: #6b7280;
    line-height: 1.7;
    margin: 0 0 2rem;
  }

  /* Contact details */
  .contact-details {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .contact-detail-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .detail-icon {
    color: var(--color-terracotta);
    flex-shrink: 0;
    width: 18px;
  }

  .detail-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .detail-link:hover {
    color: var(--color-terracotta);
  }

  /* Commission callout */
  .commission-callout {
    background: rgba(184, 151, 62, 0.08);
    border-left: 3px solid var(--color-gold);
    padding: 1rem 1.25rem;
    border-radius: 0 8px 8px 0;
  }

  .commission-callout strong {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    color: var(--color-text);
    display: block;
    margin-bottom: 0.375rem;
  }

  .commission-callout p {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: #6b7280;
    line-height: 1.6;
    margin: 0;
  }

  /* Form wrap */
  .contact-form-wrap {
    background: #ffffff;
    border-radius: var(--radius-brand, 16px);
    padding: 2rem;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  }

  @media (min-width: 768px) {
    .contact-form-wrap {
      padding: 2.5rem;
    }
  }
</style>
