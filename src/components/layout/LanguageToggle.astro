---
import { getLangFromUrl, getAlternateLang, pageSlugMap } from '../../i18n/utils';
import { t } from '../../i18n/utils';

interface Props {
  lang: 'fr' | 'en';
}

const { lang } = Astro.props;
const alternateLang = getAlternateLang(lang);
const label = t(lang, 'nav.lang-toggle');

// Build alternate URL, mapping different slugs between FR and EN
const currentPath = Astro.url.pathname;

// Pages with different slugs per language
const slugRemap: Record<string, string> = {
  '/fr/comment-ca-marche': '/en/how-it-works',
  '/en/how-it-works': '/fr/comment-ca-marche',
  '/fr/decoration-interieure': '/en/interior-design',
  '/en/interior-design': '/fr/decoration-interieure',
};

// Strip trailing slash for lookup
const lookupPath = currentPath.replace(/\/$/, '') || '/';
const altPath = slugRemap[lookupPath] ?? currentPath.replace(`/${lang}/`, `/${alternateLang}/`).replace(`/${lang}`, `/${alternateLang}`);
---

<a
  href={altPath}
  class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] px-3 font-sans font-semibold text-sm rounded-[var(--radius-brand)] border-2 border-current transition-colors duration-200 hover:bg-[var(--color-terracotta)] hover:text-white hover:border-[var(--color-terracotta)]"
  aria-label={`Switch to ${alternateLang === 'en' ? 'English' : 'Français'}`}
  data-lang-toggle
  data-target-lang={alternateLang}
>
  {label}
</a>

<script>
  document.querySelectorAll('[data-lang-toggle]').forEach(el => {
    el.addEventListener('click', () => {
      const targetLang = (el as HTMLElement).dataset.targetLang;
      if (targetLang) localStorage.setItem('kechbnb_lang', targetLang);
    });
  });
</script>
