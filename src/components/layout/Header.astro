---
import { Image } from 'astro:assets';
import LanguageToggle from './LanguageToggle.astro';
import logo from '../../assets/logo.png';
import { t } from '../../i18n/utils';

interface Props {
  lang: 'fr' | 'en';
}

const { lang } = Astro.props;

const navLinks = [
  { key: 'services',     href: `/${lang}/services` },
  { key: 'how-it-works', href: lang === 'fr' ? `/${lang}/comment-ca-marche` : `/${lang}/how-it-works` },
  { key: 'portfolio',    href: lang === 'fr' ? `/${lang}/decoration-interieure` : `/${lang}/interior-design` },
  { key: 'faq',         href: `/${lang}/faq` },
  { key: 'blog',        href: `/${lang}/blog` },
];

const whatsappMsg = lang === 'fr'
  ? 'Bonjour, je souhaite en savoir plus sur la gestion de mon bien.'
  : 'Hello, I would like to learn more about managing my property.';
---

<header class="navbar-wrap" id="site-header">
  <nav class="navbar" id="navbar" aria-label="Navigation principale">

    <!-- Logo -->
    <a href={`/${lang}`} class="nav-logo" aria-label="KechBnb — Accueil">
      <Image
        src={logo}
        alt="KechBnb"
        height={44}
        width={80}
        class="logo-default"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <!-- Desktop links -->
    <ul class="nav-links" role="list">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="nav-link">
            {t(lang, `nav.${link.key}`)}
          </a>
        </li>
      ))}
    </ul>

    <!-- Desktop actions -->
    <div class="nav-actions">
      <LanguageToggle lang={lang} />

      <a
        href={`https://wa.me/212000000000?text=${encodeURIComponent(whatsappMsg)}`}
        class="nav-whatsapp"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="WhatsApp"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp
      </a>

      <a href={`/${lang}/contact`} class="nav-cta">
        {t(lang, 'nav.cta')}
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="hamburger"
      aria-label={lang === 'fr' ? 'Ouvrir le menu' : 'Open menu'}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </nav>
</header>

<!-- Mobile menu (overlay) -->
<div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu mobile">
  <div class="mobile-menu-inner">
    <div class="mobile-menu-head">
      <Image src={logo} alt="KechBnb" height={36} width={66} loading="eager" />
      <button id="mobile-menu-close" class="mobile-close" aria-label={lang === 'fr' ? 'Fermer le menu' : 'Close menu'}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="mobile-nav" aria-label="Menu mobile">
      {navLinks.map(link => (
        <a href={link.href} class="mobile-link">
          {t(lang, `nav.${link.key}`)}
        </a>
      ))}
    </nav>

    <div class="mobile-actions">
      <LanguageToggle lang={lang} />
      <a href={`/${lang}/contact`} class="btn-primary" style="justify-content:center; width:100%;">
        {t(lang, 'nav.cta')}
      </a>
      <a
        href={`https://wa.me/212000000000?text=${encodeURIComponent(whatsappMsg)}`}
        class="mobile-whatsapp"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp
      </a>
    </div>
  </div>
</div>
<div id="mobile-overlay" class="mobile-overlay"></div>

<style>
  /* ── Wrapper: sits at top, absolute so hero bleeds under it ── */
  .navbar-wrap {
    position: absolute;
    top: 24px;
    left: 0;
    right: 0;
    z-index: 9998;
    display: flex;
    justify-content: center;
    padding: 0 24px;
    pointer-events: none;
  }

  /* ── Navbar pill ── */
  .navbar {
    pointer-events: all;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1400px;
    padding: 16px 24px;
    background: var(--navbar-bg);
    border: 1px solid var(--navbar-border);
    border-radius: 16px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: background var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }

  /* Scrolled state */
  .navbar.scrolled {
    background: var(--navbar-scrolled-bg);
    border-color: rgba(var(--color-black-rgb), 0.08);
    box-shadow: 0 4px 30px rgba(var(--color-black-rgb), 0.10);
  }

  /* When scrolled, fix position */
  .navbar-wrap.fixed {
    position: fixed;
    top: 12px;
    animation: navSlideDown 0.35s cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  @keyframes navSlideDown {
    from { opacity: 0; transform: translateY(-20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Logo ── */
  .nav-logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .logo-default {
    height: 40px;
    width: auto;
    object-fit: contain;
    transition: filter var(--transition-base);
  }

  /* Invert logo to dark when navbar is scrolled */
  .navbar.scrolled .logo-default {
    filter: brightness(0.1);
  }

  /* ── Desktop nav links ── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    padding: 10px 18px;
    font-family: var(--font-outfit);
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--navbar-link-color);
    text-decoration: none;
    border-radius: 10px;
    transition: all var(--transition-fast);
    white-space: nowrap;
    min-height: 44px;
  }

  .nav-link:hover {
    color: #ffffff;
    background: var(--navbar-link-hover-bg);
  }

  .navbar.scrolled .nav-link {
    color: var(--color-text);
  }

  .navbar.scrolled .nav-link:hover {
    color: var(--color-primary);
    background: rgba(var(--color-primary-rgb), 0.06);
  }

  /* ── Desktop actions ── */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .nav-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--color-whatsapp);
    color: #ffffff;
    font-family: var(--font-outfit);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: background var(--transition-fast), transform var(--transition-fast);
    min-height: 44px;
  }

  .nav-whatsapp:hover {
    background: #1ebe5d;
    transform: translateY(-1px);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 12px 28px;
    background: var(--color-accent);
    color: #ffffff;
    font-family: var(--font-outfit);
    font-size: 0.9375rem;
    font-weight: 500;
    border-radius: var(--radius-full);
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 4px 20px rgba(var(--color-accent-rgb), 0.35);
    transition: all var(--transition-fast);
    min-height: 44px;
  }

  .nav-cta:hover {
    opacity: 0.88;
    transform: translateY(-1px);
    box-shadow: var(--shadow-accent);
  }

  /* ── Hamburger ── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .navbar.scrolled .hamburger span {
    background: var(--color-text);
  }

  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── Mobile menu ── */
  .mobile-menu {
    position: fixed;
    top: 0;
    right: -100%;
    width: min(360px, 85vw);
    height: 100dvh;
    background: var(--color-surface);
    z-index: 10000;
    overflow-y: auto;
    transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: -8px 0 40px rgba(var(--color-black-rgb), 0.15);
  }

  .mobile-menu.open {
    right: 0;
  }

  .mobile-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(var(--color-black-rgb), 0.55);
    z-index: 9999;
    backdrop-filter: blur(4px);
  }

  .mobile-overlay.open {
    display: block;
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    padding: 24px;
    gap: 24px;
    min-height: 100%;
  }

  .mobile-menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mobile-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: rgba(var(--color-black-rgb), 0.06);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    color: var(--color-text);
    transition: background var(--transition-fast);
  }

  .mobile-close:hover {
    background: rgba(var(--color-black-rgb), 0.12);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    padding: 14px 16px;
    font-family: var(--font-outfit);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-brand);
    transition: all var(--transition-fast);
    min-height: 52px;
  }

  .mobile-link:hover {
    background: rgba(var(--color-primary-rgb), 0.06);
    color: var(--color-primary);
  }

  .mobile-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
  }

  .mobile-whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 20px;
    background: var(--color-whatsapp);
    color: #ffffff;
    font-family: var(--font-outfit);
    font-size: 0.9375rem;
    font-weight: 500;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: background var(--transition-fast);
  }

  .mobile-whatsapp:hover {
    background: #1ebe5d;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .nav-links,
    .nav-actions { display: none; }
    .hamburger   { display: flex; }
  }

  @media (max-width: 480px) {
    .navbar-wrap { padding: 0 12px; top: 12px; }
    .navbar      { padding: 12px 16px; }
  }
</style>

<script>
  const wrap    = document.getElementById('site-header') as HTMLElement;
  const navbar  = document.getElementById('navbar') as HTMLElement;
  const btn     = document.getElementById('mobile-menu-btn') as HTMLButtonElement;
  const menu    = document.getElementById('mobile-menu') as HTMLElement;
  const overlay = document.getElementById('mobile-overlay') as HTMLElement;
  const closeBtn= document.getElementById('mobile-menu-close') as HTMLButtonElement;

  // Scroll: fix + style navbar
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        const scrolled = window.scrollY > 80;
        navbar.classList.toggle('scrolled', scrolled);
        wrap.classList.toggle('fixed', scrolled);
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  // Mobile menu toggle
  function openMenu() {
    menu.classList.add('open');
    overlay.classList.add('open');
    btn.classList.add('open');
    btn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu.classList.remove('open');
    overlay.classList.remove('open');
    btn.classList.remove('open');
    btn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', () => {
    menu.classList.contains('open') ? closeMenu() : openMenu();
  });

  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  // Close on nav link click
  menu?.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', closeMenu);
  });
</script>
