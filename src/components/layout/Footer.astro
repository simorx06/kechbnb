---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import { t } from '../../i18n/utils';

interface Props {
  lang: 'fr' | 'en';
}

const { lang } = Astro.props;

const navLinks = [
  { key: 'home',        href: `/${lang}` },
  { key: 'services',    href: `/${lang}/services` },
  { key: 'how-it-works', href: lang === 'fr' ? `/${lang}/comment-ca-marche` : `/${lang}/how-it-works` },
  { key: 'portfolio',   href: lang === 'fr' ? `/${lang}/decoration-interieure` : `/${lang}/interior-design` },
  { key: 'faq',        href: `/${lang}/faq` },
  { key: 'blog',       href: `/${lang}/blog` },
  { key: 'contact',    href: `/${lang}/contact` },
];

const whatsappMsg = lang === 'fr'
  ? 'Bonjour, je souhaite en savoir plus sur la gestion de mon bien.'
  : 'Hello, I would like to learn more about managing my property.';
---

<footer class="site-footer">
  <!-- Top section -->
  <div class="footer-top">

    <!-- Brand column -->
    <div class="footer-brand">
      <Image
        src={logo}
        alt="KechBnb"
        height={40}
        width={73}
        class="footer-logo"
        loading="lazy"
      />
      <p class="footer-tagline">{t(lang, 'footer.tagline')}</p>

      <!-- WhatsApp CTA -->
      <a
        href={`https://wa.me/212000000000?text=${encodeURIComponent(whatsappMsg)}`}
        class="footer-whatsapp"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp
      </a>
    </div>

    <!-- Nav column -->
    <div class="footer-nav-col">
      <h3 class="footer-col-title">{t(lang, 'footer.nav-title')}</h3>
      <ul class="footer-links" role="list">
        {navLinks.map(link => (
          <li>
            <a href={link.href} class="footer-link">
              {t(lang, `nav.${link.key}`)}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Contact column -->
    <div class="footer-contact-col">
      <h3 class="footer-col-title">{t(lang, 'footer.contact-title')}</h3>
      <ul class="footer-contact-list" role="list">
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25Z" />
          </svg>
          <a href={`tel:${t(lang, 'contact.phone').replace(/\s/g,'')}`} class="footer-contact-link">
            {t(lang, 'contact.phone')}
          </a>
        </li>
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
          <a href={`mailto:${t(lang, 'contact.email')}`} class="footer-contact-link">
            {t(lang, 'contact.email')}
          </a>
        </li>
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0115 0z" />
          </svg>
          <span>{t(lang, 'contact.address')}</span>
        </li>
      </ul>

      <!-- Social icons -->
      <div class="footer-social">
        <h3 class="footer-col-title" style="margin-bottom: 0.75rem;">{t(lang, 'footer.social-title')}</h3>
        <div class="social-icons">
          <a href="#" aria-label="Instagram" class="social-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href="#" aria-label="Facebook" class="social-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <p class="footer-copyright">{t(lang, 'footer.copyright')}</p>
    <div class="footer-legal">
      <a href={`/${lang}/contact`} class="legal-link">
        {lang === 'fr' ? 'Politique de confidentialité' : 'Privacy Policy'}
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary-dark);
    color: rgba(var(--color-white-rgb), 0.75);
    border-top: 1px solid rgba(var(--color-white-rgb), 0.06);
  }

  /* ── Top ── */
  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4rem 1.5rem 3rem;
  }

  @media (min-width: 768px) {
    .footer-top {
      grid-template-columns: 1.5fr 1fr 1.5fr;
      gap: 4rem;
    }
  }

  /* ── Brand ── */
  .footer-logo {
    height: 36px;
    width: auto;
    filter: brightness(0) invert(1);
    margin-bottom: 1rem;
    display: block;
  }

  .footer-tagline {
    font-family: var(--font-manrope);
    font-size: 0.9rem;
    color: rgba(var(--color-white-rgb), 0.55);
    line-height: 1.65;
    margin: 0 0 1.5rem;
    max-width: 260px;
  }

  .footer-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--color-whatsapp);
    color: #ffffff;
    font-family: var(--font-outfit);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: background var(--transition-fast);
  }

  .footer-whatsapp:hover { background: #1ebe5d; }

  /* ── Nav & Contact columns ── */
  .footer-col-title {
    font-family: var(--font-outfit);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(var(--color-white-rgb), 0.4);
    margin: 0 0 1.25rem;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-link {
    font-family: var(--font-manrope);
    font-size: 0.9rem;
    color: rgba(var(--color-white-rgb), 0.65);
    text-decoration: none;
    transition: color var(--transition-fast);
    display: block;
    padding: 2px 0;
    min-height: 36px;
    display: flex;
    align-items: center;
  }

  .footer-link:hover { color: #ffffff; }

  /* Contact list */
  .footer-contact-list {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .footer-contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-family: var(--font-manrope);
    font-size: 0.875rem;
    color: rgba(var(--color-white-rgb), 0.65);
  }

  .footer-contact-list svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: rgba(var(--color-white-rgb), 0.4);
  }

  .footer-contact-link {
    color: rgba(var(--color-white-rgb), 0.65);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-contact-link:hover { color: #ffffff; }

  /* Social icons */
  .social-icons {
    display: flex;
    gap: 0.75rem;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(var(--color-white-rgb), 0.08);
    color: rgba(var(--color-white-rgb), 0.65);
    text-decoration: none;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .social-icon:hover {
    background: var(--color-accent);
    color: #ffffff;
  }

  /* ── Bottom ── */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    border-top: 1px solid rgba(var(--color-white-rgb), 0.08);
  }

  .footer-copyright {
    font-family: var(--font-manrope);
    font-size: 0.75rem;
    color: rgba(var(--color-white-rgb), 0.35);
    margin: 0;
  }

  .footer-legal { display: flex; gap: 1.5rem; }

  .legal-link {
    font-family: var(--font-manrope);
    font-size: 0.75rem;
    color: rgba(var(--color-white-rgb), 0.35);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .legal-link:hover { color: rgba(var(--color-white-rgb), 0.7); }
</style>
