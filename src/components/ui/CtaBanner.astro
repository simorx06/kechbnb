---
import Button from './Button.astro';
import { t } from '../../i18n/utils';

interface Props {
  lang: 'fr' | 'en';
  headline?: string;
}

const { lang, headline } = Astro.props;
const ctaText = t(lang, 'common.cta-global');
const defaultHeadline = lang === 'fr'
  ? 'Prêt à confier votre bien à Marrakech ?'
  : 'Ready to entrust your Marrakech property?';
---

<section class="bg-[var(--color-terracotta)] py-16 px-4">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="font-serif text-2xl md:text-3xl font-bold text-white mb-6">
      {headline ?? defaultHeadline}
    </h2>
    <Button href={`/${lang}/contact`} variant="secondary" class="border-white text-white hover:bg-white hover:text-[var(--color-terracotta)]">
      {ctaText}
    </Button>
  </div>
</section>
