---
interface Props {
  class?: string;
  hover?: boolean;
}
const { class: className = '', hover = false } = Astro.props;
const base = 'bg-white rounded-[var(--radius-brand)] shadow-[var(--shadow-card)] overflow-hidden';
const hoverClass = hover ? 'transition-shadow duration-200 hover:shadow-[var(--shadow-hover)]' : '';
---
<div class={`${base} ${hoverClass} ${className}`}>
  <slot />
</div>
