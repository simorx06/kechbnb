---
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
  ariaLabel?: string;
  disabled?: boolean;
}

const { href, type = 'button', variant = 'primary', class: className = '', ariaLabel, disabled } = Astro.props;

const base = 'inline-flex items-center justify-center gap-2 font-sans font-semibold text-sm rounded-[var(--radius-brand)] transition-all duration-200 min-h-[44px] px-6 py-3 focus-visible:outline-2 focus-visible:outline-[var(--color-terracotta)] focus-visible:outline-offset-2 cursor-pointer select-none';

const variants = {
  primary: 'bg-[var(--color-terracotta)] text-white hover:bg-[var(--color-terracotta-dark)] active:scale-[0.98]',
  secondary: 'bg-transparent border-2 border-[var(--color-terracotta)] text-[var(--color-terracotta)] hover:bg-[var(--color-terracotta)] hover:text-white',
  ghost: 'bg-transparent text-[var(--color-terracotta)] hover:underline underline-offset-4',
};

const classes = `${base} ${variants[variant]} ${className}`;
---

{href ? (
  <a href={href} class={classes} aria-label={ariaLabel}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} aria-label={ariaLabel} disabled={disabled}>
    <slot />
  </button>
)}
