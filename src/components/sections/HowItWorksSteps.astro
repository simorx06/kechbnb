---
interface Props {
  lang: 'fr' | 'en';
}

const { lang } = Astro.props;

const heading = lang === 'fr' ? 'Commencer est simple' : 'Getting started is simple';
const subheading = lang === 'fr'
  ? 'De votre premier appel à votre première réservation — nous gérons tout.'
  : 'From your first call to your first booking — we handle everything.';
const ctaText = lang === 'fr' ? 'Démarrer maintenant' : 'Get started now';

const steps = [
  {
    number: '01',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 6.75Z" />`,
    title: { fr: 'Premier contact', en: 'First contact' },
    desc: {
      fr: 'Vous nous contactez via le formulaire ou par téléphone.',
      en: 'You contact us via the form or by phone.',
    },
  },
  {
    number: '02',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />`,
    title: { fr: 'Évaluation & stratégie', en: 'Evaluation & strategy' },
    desc: {
      fr: 'Nous analysons le potentiel de votre bien et vous présentons une estimation réaliste.',
      en: 'We analyse your property\'s potential and present a realistic revenue estimate.',
    },
  },
  {
    number: '03',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" />`,
    title: { fr: 'Préparation du bien', en: 'Property preparation' },
    desc: {
      fr: 'Notre équipe s\'occupe de la décoration, mise en scène et photos professionnelles.',
      en: 'Our team handles decoration, staging and professional photography.',
    },
  },
  {
    number: '04',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0ZM18.75 10.5h.008v.008h-.008V10.5Z" />`,
    title: { fr: 'Création de l\'annonce', en: 'Listing creation' },
    desc: {
      fr: 'Nous créons et optimisons votre annonce Airbnb avec textes percutants et photos de qualité.',
      en: 'We create and optimise your Airbnb listing with compelling copy and quality photos.',
    },
  },
  {
    number: '05',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />`,
    title: { fr: 'Gestion au quotidien', en: 'Day-to-day management' },
    desc: {
      fr: 'Nous gérons réservations, communication invités, ménage et maintenance.',
      en: 'We manage bookings, guest communication, cleaning and maintenance.',
    },
  },
  {
    number: '06',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />`,
    title: { fr: 'Vous encaissez', en: 'You get paid' },
    desc: {
      fr: 'Chaque mois, vous recevez vos revenus. Nous prélevons 20% — c\'est tout.',
      en: 'Each month you receive your earnings. We take 20% — that\'s it.',
    },
  },
];
---

<section class="hiw-section" aria-labelledby="hiw-heading">
  <!-- Header -->
  <div class="hiw-header">
    <p class="hiw-eyebrow" aria-hidden="true">— {lang === 'fr' ? 'Notre processus' : 'Our process'} —</p>
    <h2 id="hiw-heading" class="hiw-heading">{heading}</h2>
    <div class="hiw-rule" aria-hidden="true"></div>
    <p class="hiw-subheading">{subheading}</p>
  </div>

  <!-- Steps -->
  <ol class="hiw-steps" aria-label={lang === 'fr' ? 'Étapes du processus' : 'Process steps'}>
    {steps.map((step, i) => (
      <li class={`hiw-step ${i % 2 === 1 ? 'hiw-step--right' : ''}`}>
        <!-- Connector line (mobile) -->
        {i < steps.length - 1 && (
          <div class="step-connector" aria-hidden="true"></div>
        )}

        <!-- Step card -->
        <div class="step-card">
          <!-- Number + icon -->
          <div class="step-meta">
            <span class="step-number" aria-hidden="true">{step.number}</span>
            <div class="step-icon-wrap" aria-hidden="true">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
                set:html={step.icon}
              />
            </div>
          </div>

          <!-- Content -->
          <div class="step-content">
            <h3 class="step-title">{step.title[lang]}</h3>
            <p class="step-desc">{step.desc[lang]}</p>
          </div>
        </div>
      </li>
    ))}
  </ol>

  <!-- CTA -->
  <div class="hiw-cta">
    <a href={`/${lang}/contact`} class="hiw-btn">
      {ctaText}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
      </svg>
    </a>
  </div>
</section>

<style>
  .hiw-section {
    background: #ffffff;
    padding: 5rem 1.25rem;
    overflow: hidden;
  }

  /* Header */
  .hiw-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 4rem;
  }

  .hiw-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0 0 1rem;
  }

  .hiw-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 1rem;
  }

  .hiw-rule {
    width: 3rem;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
    margin: 0 auto 1.25rem;
  }

  .hiw-subheading {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: #6b7280;
    line-height: 1.65;
    margin: 0;
  }

  /* Steps list */
  .hiw-steps {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }

  /* Vertical line (mobile) */
  .hiw-steps::before {
    content: '';
    position: absolute;
    left: 28px;
    top: 32px;
    bottom: 32px;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--color-gold) 10%, var(--color-gold) 90%, transparent);
    opacity: 0.4;
  }

  /* Individual step */
  .hiw-step {
    position: relative;
    padding: 0 0 2.5rem 0;
  }

  .hiw-step:last-child {
    padding-bottom: 0;
  }

  .step-connector {
    display: none; /* handled by ::before on mobile */
  }

  /* Step card */
  .step-card {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--color-offwhite);
    border-radius: 16px;
    margin-left: 0;
    position: relative;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .step-card:hover {
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  /* Meta: number + icon */
  .step-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
  }

  .step-number {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-terracotta);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .step-icon-wrap {
    width: 36px;
    height: 36px;
    background: white;
    border: 1px solid rgba(196, 113, 74, 0.2);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-terracotta);
  }

  /* Content */
  .step-content {
    flex: 1;
    min-width: 0;
    padding-top: 0.25rem;
  }

  .step-title {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .step-desc {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: #6b7280;
    line-height: 1.7;
    margin: 0;
  }

  /* Gold accent line on left */
  .step-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1rem;
    bottom: 1rem;
    width: 3px;
    background: linear-gradient(180deg, var(--color-gold), var(--color-terracotta));
    border-radius: 0 0 0 16px;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .step-card:hover::before {
    opacity: 1;
  }

  /* CTA */
  .hiw-cta {
    text-align: center;
    margin-top: 3.5rem;
  }

  .hiw-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    background: var(--color-terracotta);
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 0.9375rem 2rem;
    border-radius: var(--radius-brand, 12px);
    min-height: 52px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 16px rgba(196, 113, 74, 0.3);
  }

  .hiw-btn:hover {
    background: #b5623f;
    box-shadow: 0 6px 24px rgba(196, 113, 74, 0.4);
    transform: translateY(-1px);
  }

  .hiw-btn:active {
    transform: translateY(0);
  }

  .hiw-btn svg {
    transition: transform 0.2s ease;
  }

  .hiw-btn:hover svg {
    transform: translateX(3px);
  }

  /* ─── Desktop: zigzag layout ─── */
  @media (min-width: 768px) {
    .hiw-section {
      padding: 6rem 2rem;
    }

    .hiw-steps {
      max-width: 1000px;
      gap: 1.5rem;
    }

    /* Hide mobile connector line */
    .hiw-steps::before {
      display: none;
    }

    .hiw-step {
      padding: 0;
      width: 55%;
    }

    /* Odd steps: left aligned */
    .hiw-step:nth-child(odd) {
      align-self: flex-start;
    }

    /* Even steps: right aligned (zigzag) */
    .hiw-step:nth-child(even) {
      align-self: flex-end;
    }

    .step-card {
      gap: 1.75rem;
      padding: 2rem 2rem 2rem 1.75rem;
    }

    .step-number {
      font-size: 2.5rem;
    }

    .step-icon-wrap {
      width: 42px;
      height: 42px;
    }

    .step-title {
      font-size: 1.125rem;
    }

    .step-desc {
      font-size: 0.9375rem;
    }
  }

  /* Reduce motion */
  @media (prefers-reduced-motion: reduce) {
    .step-card,
    .hiw-btn,
    .hiw-btn svg {
      transition: none;
    }
    .step-card:hover {
      transform: none;
    }
  }
</style>
