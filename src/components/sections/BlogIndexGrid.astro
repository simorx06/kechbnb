---
interface Article {
  id: string;
  slug: string;
  data: {
    title: string;
    category: string;
    pubDate: Date;
    excerpt: string;
    featured: boolean;
  };
}

interface Props {
  lang: 'fr' | 'en';
  articles: Article[];
}

const { lang, articles } = Astro.props;

const categoryLabels: Record<string, Record<string, string>> = {
  fr: { tips: 'Conseils propriétaires', market: 'Marché Marrakech', 'guest-experience': 'Expérience invités' },
  en: { tips: 'Landlord Tips', market: 'Marrakech Market', 'guest-experience': 'Guest Experience' },
};

const readMore = lang === 'fr' ? 'Lire la suite' : 'Read more';
const tag      = lang === 'fr' ? 'Notre Blog' : 'Our Blog';
const heading  = lang === 'fr' ? 'Conseils & <em>actualités</em>' : 'Tips & <em>insights</em>';
const sub      = lang === 'fr'
  ? 'Conseils, analyses et guides pour les propriétaires Airbnb à Marrakech.'
  : 'Advice, analysis and guides for Airbnb landlords in Marrakech.';

const sorted = [...articles].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<section class="blog-section" aria-labelledby="blog-heading">
  <!-- Header -->
  <div class="blog-header" data-reveal>
    <p class="section-tag">{tag}</p>
    <h1 id="blog-heading" class="blog-heading" set:html={heading}></h1>
    <p class="blog-sub">{sub}</p>
  </div>

  <!-- Articles grid -->
  <div class="blog-grid" role="list" data-stagger data-stagger-delay="0.1">
    {sorted.map((article, i) => {
      const href = `/${lang}/blog/${article.id.replace(`${lang}/`, '')}`;
      const dateStr = article.data.pubDate.toLocaleDateString(
        lang === 'fr' ? 'fr-MA' : 'en-GB',
        { day: 'numeric', month: 'long', year: 'numeric' }
      );
      return (
        <article class="blog-card" role="listitem" data-stagger-child>

          <!-- Image placeholder with gradient -->
          <a href={href} class="card-img-wrap" tabindex="-1" aria-hidden="true">
            <div class="card-img-bg"></div>
            <span class="card-category-badge">
              {categoryLabels[lang][article.data.category] ?? article.data.category}
            </span>
          </a>

          <!-- Content -->
          <div class="card-body">
            <div class="card-meta">
              <time class="card-date" datetime={article.data.pubDate.toISOString()}>
                {dateStr}
              </time>
            </div>

            <h2 class="card-title">
              <a href={href} class="card-title-link">
                {article.data.title}
              </a>
            </h2>

            <p class="card-excerpt">{article.data.excerpt}</p>

            <a href={href} class="card-readmore" aria-label={`${readMore} — ${article.data.title}`}>
              {readMore}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
              </svg>
            </a>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .blog-section {
    background: var(--color-offwhite);
    padding: var(--space-xl) 1.5rem var(--space-l);
  }

  /* ── Header ── */
  .blog-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--space-m);
  }

  .blog-heading {
    font-family: var(--font-outfit);
    font-size: clamp(2rem, 4vw + 0.5rem, 3.25rem);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  .blog-heading em {
    font-family: var(--font-newsreader);
    font-style: italic;
    color: var(--color-accent);
  }

  .blog-sub {
    font-family: var(--font-manrope);
    font-size: 1.0625rem;
    color: var(--color-text-medium);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Grid ── */
  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 640px)  { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .blog-grid { grid-template-columns: repeat(3, 1fr); } }

  /* ── Card ── */
  .blog-card {
    background: #ffffff;
    border-radius: var(--radius-card);
    border: 1px solid rgba(var(--color-black-rgb), 0.07);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .blog-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-hover);
  }

  /* Image area */
  .card-img-wrap {
    position: relative;
    display: block;
    height: 200px;
    overflow: hidden;
    text-decoration: none;
  }

  .card-img-bg {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 60%, rgba(var(--color-accent-rgb), 0.4) 100%);
    transition: transform 0.5s ease;
  }

  .blog-card:hover .card-img-bg {
    transform: scale(1.04);
  }

  .card-category-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(var(--color-white-rgb), 0.92);
    color: var(--color-primary);
    font-family: var(--font-outfit);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 50px;
    backdrop-filter: blur(8px);
  }

  /* Content */
  .card-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .card-date {
    font-family: var(--font-manrope);
    font-size: 0.75rem;
    color: var(--color-text-medium);
  }

  /* Title */
  .card-title {
    font-family: var(--font-outfit);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-title-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .card-title-link:hover { color: var(--color-accent); }

  /* Excerpt */
  .card-excerpt {
    font-family: var(--font-manrope);
    font-size: 0.9rem;
    color: var(--color-text-medium);
    line-height: 1.7;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Read more */
  .card-readmore {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-outfit);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    margin-top: auto;
    transition: gap var(--transition-fast);
  }

  .card-readmore:hover { gap: 0.625rem; }

  @media (prefers-reduced-motion: reduce) {
    .blog-card { animation: none; opacity: 1; transition: none; }
    .blog-card:hover { transform: none; }
    .card-img-bg { transition: none; }
  }
</style>
