---
interface Props {
  lang: 'fr' | 'en';
}

const { lang } = Astro.props;

const tag     = lang === 'fr' ? 'Tarification' : 'Pricing';
const heading = lang === 'fr' ? 'Nos <em>formules</em>' : 'Our <em>plans</em>';
const sub     = lang === 'fr'
  ? 'Une commission simple et transparente, selon le niveau d\'accompagnement choisi.'
  : 'A simple, transparent commission based on the level of support you choose.';

const plans = lang === 'fr'
  ? [
      {
        icon: '🏠',
        name: 'Essentiel',
        tagline: 'Gestion opérationnelle complète',
        commission: '20%',
        commissionLabel: 'par réservation',
        features: [
          'Création et optimisation des annonces',
          'Communication invités 24/7',
          'Coordination ménage & linge',
          'Tarification dynamique',
          'Suivi maintenance',
          'Rapport mensuel de revenus',
        ],
        cta: 'Choisir Essentiel',
        recommended: false,
      },
      {
        icon: '✨',
        name: 'Premium',
        tagline: 'Essentiel + décoration & shooting',
        commission: '25%',
        commissionLabel: 'par réservation',
        features: [
          'Tout ce qui est inclus dans Essentiel',
          'Décoration intérieure & staging',
          'Shooting photo professionnel',
          'Annonce multi-plateformes (Airbnb, Booking…)',
          'Gestion des conciergeries',
          'Accompagnement fiscal & juridique',
        ],
        cta: 'Choisir Premium',
        recommended: true,
      },
    ]
  : [
      {
        icon: '🏠',
        name: 'Essential',
        tagline: 'Complete operational management',
        commission: '20%',
        commissionLabel: 'per booking',
        features: [
          'Listing creation & optimisation',
          '24/7 guest communication',
          'Cleaning & linen coordination',
          'Dynamic pricing',
          'Maintenance follow-up',
          'Monthly revenue report',
        ],
        cta: 'Choose Essential',
        recommended: false,
      },
      {
        icon: '✨',
        name: 'Premium',
        tagline: 'Essential + interior design & shoots',
        commission: '25%',
        commissionLabel: 'per booking',
        features: [
          'Everything in Essential',
          'Interior design & staging',
          'Professional photo shoot',
          'Multi-platform listings (Airbnb, Booking…)',
          'Concierge services management',
          'Tax & legal support',
        ],
        cta: 'Choose Premium',
        recommended: true,
      },
    ];
---

<section class="pricing-section" aria-labelledby="pricing-heading">
  <!-- Header -->
  <div class="pricing-header">
    <p class="section-tag">{tag}</p>
    <h2 id="pricing-heading" class="pricing-heading" set:html={heading}></h2>
    <p class="pricing-sub">{sub}</p>
  </div>

  <!-- Cards -->
  <div class="pricing-grid">
    {plans.map((plan, i) => (
      <div class={`pricing-card ${plan.recommended ? 'recommended' : ''}`} style={`animation-delay: ${i * 0.15}s`}>
        {plan.recommended && (
          <div class="recommended-badge">
            {lang === 'fr' ? 'Recommandé' : 'Recommended'}
          </div>
        )}

        <div class="plan-icon">{plan.icon}</div>
        <h3 class="plan-name">{plan.name}</h3>
        <p class="plan-tagline">{plan.tagline}</p>

        <div class="plan-price">
          <span class="price-value">{plan.commission}</span>
          <span class="price-label">{plan.commissionLabel}</span>
        </div>

        <ul class="plan-features" role="list">
          {plan.features.map(f => (
            <li class="plan-feature">
              <svg class="feature-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              {f}
            </li>
          ))}
        </ul>

        <a href={`/${lang}/contact`} class={`plan-cta ${plan.recommended ? 'plan-cta-primary' : 'plan-cta-outline'}`}>
          {plan.cta}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
          </svg>
        </a>
      </div>
    ))}
  </div>
</section>

<style>
  .pricing-section {
    background: var(--color-offwhite);
    padding: var(--space-xl) 1.5rem;
  }

  /* ── Header ── */
  .pricing-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-m);
  }

  .pricing-heading {
    font-family: var(--font-outfit);
    font-size: clamp(2rem, 4vw + 0.5rem, 3.25rem);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  .pricing-heading em {
    font-family: var(--font-newsreader);
    font-style: italic;
    color: var(--color-accent);
  }

  .pricing-sub {
    font-family: var(--font-manrope);
    font-size: 1.0625rem;
    color: var(--color-text-medium);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Grid ── */
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .pricing-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* ── Card ── */
  .pricing-card {
    position: relative;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    opacity: 0;
    animation: cardSlideIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .pricing-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-hover);
  }

  .pricing-card.recommended {
    border-color: var(--color-accent);
    box-shadow: 0 4px 30px rgba(var(--color-accent-rgb), 0.15);
  }

  /* Recommended badge */
  .recommended-badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-outfit);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 16px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  /* Plan info */
  .plan-icon { font-size: 2rem; line-height: 1; }

  .plan-name {
    font-family: var(--font-outfit);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .plan-tagline {
    font-family: var(--font-manrope);
    font-size: 0.9rem;
    color: var(--color-text-medium);
    margin: 0;
    line-height: 1.5;
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .price-value {
    font-family: var(--font-outfit);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
  }

  .pricing-card.recommended .price-value { color: var(--color-accent); }

  .price-label {
    font-family: var(--font-manrope);
    font-size: 0.875rem;
    color: var(--color-text-medium);
  }

  /* Features */
  .plan-features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
  }

  .plan-feature {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-family: var(--font-manrope);
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .feature-check {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-primary);
  }

  .pricing-card.recommended .feature-check { color: var(--color-accent); }

  /* CTA buttons */
  .plan-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    border-radius: var(--radius-full);
    font-family: var(--font-outfit);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    transition: all var(--transition-fast);
    min-height: 52px;
    margin-top: 0.5rem;
  }

  .plan-cta-primary {
    background: var(--color-accent);
    color: #fff;
    box-shadow: 0 4px 20px rgba(var(--color-accent-rgb), 0.3);
  }

  .plan-cta-primary:hover {
    opacity: 0.88;
    transform: translateY(-1px);
    box-shadow: var(--shadow-accent);
  }

  .plan-cta-outline {
    background: transparent;
    color: var(--color-primary);
    border: 1.5px solid var(--color-primary);
  }

  .plan-cta-outline:hover {
    background: var(--color-primary);
    color: #fff;
  }

  @keyframes cardSlideIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-card { animation: none; opacity: 1; transition: none; }
  }
</style>
