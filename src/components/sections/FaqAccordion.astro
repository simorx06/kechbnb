---
interface FaqItem {
  id: string;
  question: string;
  answer: string;
  order: number;
}

interface Props {
  lang: 'fr' | 'en';
  items: FaqItem[];
}

const { lang, items } = Astro.props;
const sorted = [...items].sort((a, b) => a.order - b.order);

const tag     = 'FAQ';
const heading = lang === 'fr' ? 'Questions <em>fréquentes</em>' : 'Frequently asked <em>questions</em>';
const ctaText = lang === 'fr' ? 'Vous avez d\'autres questions ?' : 'Still have questions?';
const ctaLink = lang === 'fr' ? 'Contactez-nous' : 'Contact us';
---

<section class="faq-section" aria-labelledby="faq-heading">

  <div class="faq-inner">
    <!-- Header -->
    <div class="faq-header" data-reveal>
      <p class="section-tag">{tag}</p>
      <h2 id="faq-heading" class="faq-heading" set:html={heading}></h2>
      <p class="faq-sub">
        {lang === 'fr'
          ? 'Tout ce que vous devez savoir sur la gestion Airbnb à Marrakech.'
          : 'Everything you need to know about Airbnb management in Marrakech.'}
      </p>
    </div>

    <!-- Accordion list -->
    <div class="faq-list" role="list" data-stagger data-stagger-delay="0.07">
      {sorted.map((item, i) => (
        <details
          class="faq-item"
          role="listitem"
          data-stagger-child
        >
          <summary class="faq-question">
            <span class="question-text">{item.question}</span>
            <span class="question-icon" aria-hidden="true">
              <svg class="icon-plus" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
              <svg class="icon-minus" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" />
              </svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- CTA -->
    <div class="faq-cta">
      <p class="faq-cta-text">{ctaText}</p>
      <a href={`/${lang}/contact`} class="btn-primary">
        {ctaLink}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .faq-section {
    background: linear-gradient(160deg, #f8f9fa 0%, rgba(44,74,87,0.04) 100%);
    padding: var(--space-xl) 1.5rem var(--space-l);
  }

  .faq-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  /* ── Header ── */
  .faq-header {
    text-align: center;
    margin-bottom: var(--space-m);
  }

  .faq-heading {
    font-family: var(--font-outfit);
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  .faq-heading em {
    font-family: var(--font-newsreader);
    font-style: italic;
    color: var(--color-accent);
  }

  .faq-sub {
    font-family: var(--font-manrope);
    font-size: 1.0625rem;
    color: var(--color-text-medium);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Accordion ── */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .faq-item {
    background: rgba(var(--color-white-rgb), 0.8);
    border: 1px solid rgba(var(--color-black-rgb), 0.08);
    border-radius: 16px;
    overflow: hidden;
    transition: background var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
    cursor: pointer;
  }

  .faq-item:hover {
    background: rgba(var(--color-white-rgb), 0.95);
    border-color: rgba(var(--color-primary-rgb), 0.2);
  }

  .faq-item[open] {
    background: #ffffff;
    border-color: rgba(var(--color-accent-rgb), 0.3);
    box-shadow: 0 4px 20px rgba(var(--color-accent-rgb), 0.08);
  }

  /* Question */
  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.375rem 1.5rem;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker { display: none; }
  .faq-question::marker               { display: none; }

  .question-text {
    font-family: var(--font-outfit);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.4;
    flex: 1;
  }

  .question-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .icon-minus { display: none; }

  .faq-item[open] .icon-plus  { display: none; }
  .faq-item[open] .icon-minus { display: block; }
  .faq-item[open] .question-icon { transform: rotate(180deg); }

  /* Answer */
  .faq-answer {
    padding: 0 1.5rem 1.375rem;
    border-top: 1px solid rgba(var(--color-black-rgb), 0.06);
  }

  .faq-answer p {
    font-family: var(--font-manrope);
    font-size: 0.9375rem;
    color: var(--color-text-medium);
    line-height: 1.8;
    margin: 1rem 0 0;
  }

  /* ── CTA ── */
  .faq-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: var(--space-m);
    text-align: center;
  }

  .faq-cta-text {
    font-family: var(--font-outfit);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
  }

  @media (min-width: 768px) {
    .faq-section { padding: var(--space-xl) 2rem; }
    .question-text { font-size: 1.0625rem; }
    .faq-question { padding: 1.5rem 2rem; }
    .faq-answer   { padding: 0 2rem 1.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item { animation: none; opacity: 1; transition: none; }
    .question-icon { transition: none; }
  }
</style>
