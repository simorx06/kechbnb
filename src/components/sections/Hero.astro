---
import { Image } from 'astro:assets';
import slide1 from '../../assets/images/portfolio/riad-1-salon.jpg';
import slide2 from '../../assets/images/portfolio/riad-1-terrasse.jpg';
import slide3 from '../../assets/images/portfolio/appart-1-salon.jpg';
import slide4 from '../../assets/images/portfolio/appart-2-salon.jpg';

interface Props {
  lang: 'fr' | 'en';
  headline: string;
  subheadline: string;
  ctaText: string;
  badgeText: string;
}

const { lang, headline, subheadline, ctaText, badgeText } = Astro.props;

const slides = [slide1, slide2, slide3, slide4];

const benefits = lang === 'fr'
  ? [
      { icon: '📈', text: '+40% de revenus vs location longue durée' },
      { icon: '🏠', text: '50+ biens gérés à Marrakech' },
      { icon: '⭐', text: '87% de taux d\'occupation moyen' },
      { icon: '💳', text: 'Paiement garanti chaque mois' },
      { icon: '🔑', text: 'Gestion 100% prise en charge' },
      { icon: '📸', text: 'Photos professionnelles incluses' },
      { icon: '🛎️', text: 'Accueil invités 7j/7' },
      { icon: '🧹', text: 'Ménage & linge coordonnés' },
    ]
  : [
      { icon: '📈', text: '+40% revenue vs long-term rental' },
      { icon: '🏠', text: '50+ properties managed in Marrakech' },
      { icon: '⭐', text: '87% average occupancy rate' },
      { icon: '💳', text: 'Guaranteed monthly payment' },
      { icon: '🔑', text: '100% hands-off management' },
      { icon: '📸', text: 'Professional photos included' },
      { icon: '🛎️', text: 'Guest welcome 7 days a week' },
      { icon: '🧹', text: 'Cleaning & linen coordinated' },
    ];

// Double the array so seamless infinite scroll works
const benefitsDouble = [...benefits, ...benefits];

const headlineParts = headline.split(',');
---

<section class="hero" aria-label={lang === 'fr' ? 'Présentation KechBnb' : 'KechBnb introduction'}>

  <!-- ── Slides ── -->
  <div class="hero-slider" aria-hidden="true">
    {slides.map((src, i) => (
      <div class={`slide ${i === 0 ? 'active' : ''}`} data-index={i}>
        <Image
          src={src}
          alt=""
          width={1920}
          height={1080}
          format="webp"
          quality={85}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
          class="slide-img"
        />
      </div>
    ))}
    <div class="hero-overlay"></div>
  </div>

  <!-- ── Content ── -->
  <div class="hero-content">
    <div class="hero-inner">

      <!-- Badge -->
      <div class="hero-badge" data-reveal data-delay="0.1">
        <span class="badge-dot" aria-hidden="true"></span>
        {badgeText}
      </div>

      <!-- Headline -->
      <h1 class="hero-headline" data-reveal data-delay="0.2">
        {headlineParts.length > 1
          ? <>
              {headlineParts[0]},<br/>
              <em class="italic-highlight">{headlineParts.slice(1).join(',').trim()}</em>
            </>
          : headline
        }
      </h1>

      <!-- Subheadline -->
      <p class="hero-sub" data-reveal data-delay="0.32">{subheadline}</p>

      <!-- CTAs -->
      <div class="hero-ctas" data-reveal data-delay="0.44">
        <a href={`/${lang}/contact`} class="btn-primary hero-btn-primary">
          {ctaText}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
          </svg>
        </a>
        <a href={`/${lang}/services`} class="btn-secondary hero-btn-secondary">
          {lang === 'fr' ? 'Découvrir nos services' : 'Discover our services'}
        </a>
      </div>

    </div>
  </div>

  <!-- ── Slide dots ── -->
  <div class="hero-dots" aria-label={lang === 'fr' ? 'Diaporama' : 'Slideshow'}>
    {slides.map((_, i) => (
      <button
        class={`dot ${i === 0 ? 'active' : ''}`}
        data-slide={i}
        aria-label={`Slide ${i + 1}`}
      ></button>
    ))}
  </div>

  <!-- ── Scroll indicator ── -->
  <div class="scroll-indicator" aria-hidden="true">
    <div class="scroll-line"></div>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
  </div>
</section>

<!-- ── Benefits strip ── -->
<div class="benefits-strip" aria-hidden="true">
  <div class="benefits-track">
    {benefitsDouble.map(b => (
      <div class="benefit-card">
        <span class="benefit-icon">{b.icon}</span>
        <span class="benefit-text">{b.text}</span>
      </div>
    ))}
  </div>
</div>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: 100svh;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* ── Slider ── */
  .hero-slider {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .slide.active {
    opacity: 1;
  }

  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform: scale(1.04);
    transition: transform 8s ease-out;
  }

  .slide.active .slide-img {
    transform: scale(1);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(26, 46, 56, 0.72) 0%,
      rgba(26, 46, 56, 0.55) 50%,
      rgba(0, 0, 0, 0.65) 100%
    );
    z-index: 1;
  }

  /* ── Content ── */
  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 8rem 2rem 6rem;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .hero-inner {
    max-width: 700px;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(var(--color-white-rgb), 0.1);
    border: 1px solid rgba(var(--color-white-rgb), 0.2);
    backdrop-filter: blur(8px);
    color: rgba(var(--color-white-rgb), 0.9);
    font-family: var(--font-outfit);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
    animation: pulse 2s ease-in-out infinite;
  }

  /* Headline */
  .hero-headline {
    font-family: var(--font-outfit);
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    font-weight: 600;
    color: #ffffff;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 1.25rem;
    text-shadow: 0 2px 20px rgba(0,0,0,0.3);
  }

  .italic-highlight {
    font-family: var(--font-newsreader);
    font-style: italic;
    color: var(--color-accent);
  }

  /* Subheadline */
  .hero-sub {
    font-family: var(--font-manrope);
    font-size: clamp(1rem, 1.8vw, 1.125rem);
    color: rgba(var(--color-white-rgb), 0.82);
    line-height: 1.65;
    margin: 0 0 2.25rem;
    max-width: 580px;
    text-shadow: 0 1px 8px rgba(0,0,0,0.25);
  }

  /* CTAs */
  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    background: var(--color-accent);
    color: #ffffff;
    font-family: var(--font-outfit);
    font-size: 1.0625rem;
    font-weight: 500;
    padding: 1rem 2rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    box-shadow: 0 8px 30px rgba(var(--color-accent-rgb), 0.45);
    transition: all var(--transition-fast);
    min-height: 56px;
    white-space: nowrap;
  }

  .hero-btn-primary:hover {
    opacity: 0.88;
    transform: translateY(-2px);
    box-shadow: var(--shadow-accent);
  }

  .hero-btn-primary svg {
    transition: transform var(--transition-fast);
  }

  .hero-btn-primary:hover svg {
    transform: translateX(4px);
  }

  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(var(--color-white-rgb), 0.08);
    backdrop-filter: blur(25px);
    color: #ffffff;
    font-family: var(--font-outfit);
    font-size: 1.0625rem;
    font-weight: 400;
    padding: 1rem 2rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(var(--color-white-rgb), 0.15);
    text-decoration: none;
    transition: all var(--transition-fast);
    min-height: 56px;
    white-space: nowrap;
  }

  .hero-btn-secondary:hover {
    background: rgba(var(--color-white-rgb), 0.15);
    border-color: rgba(var(--color-white-rgb), 0.3);
  }

  /* ── Dots ── */
  .hero-dots {
    position: absolute;
    bottom: 5rem;
    right: 2rem;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(var(--color-white-rgb), 0.35);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .dot.active {
    background: var(--color-accent);
    transform: scale(1.25);
  }

  /* ── Scroll indicator ── */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    opacity: 0.7;
  }

  .scroll-line {
    width: 1px;
    height: 2rem;
    background: linear-gradient(180deg, transparent, rgba(var(--color-white-rgb), 0.5));
    animation: scrollPulse 2s ease-in-out infinite;
  }

  .scroll-indicator svg {
    animation: bounce 2s ease-in-out infinite;
    opacity: 0.7;
  }

  /* ── Animations ── */
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(5px); }
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; }
    50%       { opacity: 0.7; }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.5; transform: scale(0.8); }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .hero-inner, .hero-badge, .hero-headline,
    .hero-sub, .hero-ctas, .hero-dots,
    .scroll-indicator, .badge-dot, .scroll-line,
    .scroll-indicator svg, .slide, .slide-img { animation: none; transition: none; }
    .slide.active { opacity: 1; }
  }

  /* ── Mobile ── */
  @media (max-width: 600px) {
    .hero-content {
      padding: 7rem 1.25rem 5rem;
      justify-content: center;
      text-align: center;
    }
    .hero-inner { display: flex; flex-direction: column; align-items: center; }
    .hero-sub   { text-align: center; }
    .hero-ctas  { flex-direction: column; width: 100%; }
    .hero-btn-primary,
    .hero-btn-secondary { justify-content: center; width: 100%; }
    .hero-dots  { right: 1rem; bottom: 4rem; }
  }
</style>

<!-- ── Benefits strip (outside hero, below it) ── -->
<style>
  .benefits-strip {
    background: var(--color-primary-dark);
    overflow: hidden;
    padding: 18px 0;
    position: relative;
  }

  .benefits-strip::before,
  .benefits-strip::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 120px;
    z-index: 1;
    pointer-events: none;
  }

  .benefits-strip::before {
    left: 0;
    background: linear-gradient(90deg, var(--color-primary-dark), transparent);
  }

  .benefits-strip::after {
    right: 0;
    background: linear-gradient(-90deg, var(--color-primary-dark), transparent);
  }

  .benefits-track {
    display: flex;
    gap: 0;
    width: max-content;
    animation: slide 35s linear infinite;
  }

  .benefit-card {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 32px;
    border-right: 1px solid rgba(var(--color-white-rgb), 0.08);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .benefit-icon {
    font-size: 1.125rem;
    flex-shrink: 0;
  }

  .benefit-text {
    font-family: var(--font-outfit);
    font-size: 0.875rem;
    font-weight: 400;
    color: rgba(var(--color-white-rgb), 0.75);
    letter-spacing: 0.01em;
  }

  @keyframes slide {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .benefits-track { animation: none; }
  }
</style>

<script>
  const slides = document.querySelectorAll<HTMLElement>('.slide');
  const dots   = document.querySelectorAll<HTMLButtonElement>('.dot');
  let current  = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    slides[current].classList.remove('active');
    dots[current]?.classList.remove('active');
    current = (index + slides.length) % slides.length;
    slides[current].classList.add('active');
    dots[current]?.classList.add('active');
  }

  function startTimer() {
    timer = setInterval(() => goTo(current + 1), 5500);
  }

  function resetTimer() {
    clearInterval(timer);
    startTimer();
  }

  // Dot click
  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => { goTo(i); resetTimer(); });
  });

  // Pause on hover
  const hero = document.querySelector<HTMLElement>('.hero');
  hero?.addEventListener('mouseenter', () => clearInterval(timer));
  hero?.addEventListener('mouseleave', startTimer);

  startTimer();
</script>
