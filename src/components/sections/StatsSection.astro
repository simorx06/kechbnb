---
interface Stat {
  id: string;
  value: string;
  label: { fr: string; en: string };
  footnote: { fr: string; en: string };
  order: number;
}

interface Props {
  lang: 'fr' | 'en';
  stats: Stat[];
}

const { lang, stats } = Astro.props;
const sorted = [...stats].sort((a, b) => a.order - b.order);
---

<section class="stats-section" aria-labelledby="stats-heading">
  <div class="stats-inner">
    <h2 class="stats-eyebrow" id="stats-heading">
      {lang === 'fr' ? 'Nos résultats en chiffres' : 'Our results in numbers'}
    </h2>

    <ul class="stats-list" role="list">
      {sorted.map((stat, i) => (
        <li class="stat-item" style={`animation-delay: ${i * 0.12}s`}>
          <span class="stat-value">{stat.value}</span>
          <p class="stat-label">{stat.label[lang]}</p>
          <p class="stat-footnote">{stat.footnote[lang]}</p>
          {i < sorted.length - 1 && <div class="stat-divider" aria-hidden="true"></div>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stats-section {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    padding: var(--space-l) 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .stats-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 100%, rgba(var(--color-accent-rgb), 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .stats-inner {
    max-width: 1000px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .stats-eyebrow {
    text-align: center;
    font-family: var(--font-outfit);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(var(--color-white-rgb), 0.45);
    margin: 0 0 2.5rem;
  }

  .stats-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .stat-item {
    text-align: center;
    position: relative;
    opacity: 0;
    animation: statReveal 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .stat-value {
    display: block;
    font-family: var(--font-outfit);
    font-size: clamp(3rem, 8vw, 4.5rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 0.625rem;
  }

  .stat-label {
    font-family: var(--font-outfit);
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    font-weight: 500;
    color: rgba(var(--color-white-rgb), 0.85);
    line-height: 1.4;
    margin: 0 0 0.375rem;
  }

  .stat-footnote {
    font-family: var(--font-manrope);
    font-size: 0.75rem;
    color: rgba(var(--color-white-rgb), 0.45);
    line-height: 1.5;
    margin: 0;
    font-style: italic;
  }

  .stat-divider {
    position: absolute;
    bottom: -1.25rem;
    left: 25%;
    right: 25%;
    height: 1px;
    background: rgba(var(--color-white-rgb), 0.1);
  }

  @media (min-width: 768px) {
    .stats-section { padding: var(--space-l) 2rem; }
    .stats-list {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      align-items: start;
    }
    .stat-item { padding: 0 2.5rem; }
    .stat-divider {
      position: absolute;
      top: 10%; bottom: 10%;
      right: 0; left: auto;
      width: 1px; height: auto;
      background: rgba(var(--color-white-rgb), 0.15);
    }
  }

  @keyframes statReveal {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .stat-item { animation: none; opacity: 1; }
  }
</style>
