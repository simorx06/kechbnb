---
interface Stat {
  id: string;
  value: string;
  label: { fr: string; en: string };
  footnote: { fr: string; en: string };
  order: number;
}

interface Props {
  lang: 'fr' | 'en';
  stats: Stat[];
}

const { lang, stats } = Astro.props;
const sorted = [...stats].sort((a, b) => a.order - b.order);
---

<section class="stats-section" aria-labelledby="stats-heading">
  <div class="stats-eyebrow-wrap">
    <h2 class="stats-eyebrow" id="stats-heading">
      {lang === 'fr' ? 'Nos résultats en chiffres' : 'Our results in numbers'}
    </h2>
  </div>

  <ul class="stats-list" role="list">
    {sorted.map((stat, i) => (
      <li class="stat-item" style={`animation-delay: ${i * 0.12}s`}>
        <!-- Decorative number -->
        <div class="stat-value-wrap" aria-hidden="true">
          <span class="stat-value">{stat.value}</span>
        </div>

        <!-- Label + footnote -->
        <div class="stat-text">
          <p class="stat-label">{stat.label[lang]}</p>
          <p class="stat-footnote">{stat.footnote[lang]}</p>
        </div>

        <!-- Divider (not on last) -->
        {i < sorted.length - 1 && (
          <div class="stat-divider" aria-hidden="true"></div>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .stats-section {
    background: var(--color-terracotta);
    padding: 4rem 1.25rem;
    position: relative;
    overflow: hidden;
  }

  /* Subtle background texture */
  .stats-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 100%, rgba(0,0,0,0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .stats-eyebrow-wrap {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .stats-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.65);
    margin: 0;
  }

  /* Stats list */
  .stats-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 1000px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    position: relative;
    z-index: 1;
  }

  /* Stat item */
  .stat-item {
    text-align: center;
    position: relative;
    opacity: 0;
    animation: statReveal 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  /* Big gold number */
  .stat-value-wrap {
    margin-bottom: 0.625rem;
  }

  .stat-value {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 8vw, 4rem);
    font-weight: 700;
    color: var(--color-gold);
    line-height: 1;
    letter-spacing: -0.02em;
    display: inline-block;
    text-shadow: 0 2px 12px rgba(0,0,0,0.2);
  }

  .stat-label {
    font-family: var(--font-sans);
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    font-weight: 600;
    color: #ffffff;
    line-height: 1.4;
    margin: 0 0 0.375rem;
  }

  .stat-footnote {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.5;
    margin: 0;
    font-style: italic;
  }

  /* Horizontal divider on mobile */
  .stat-divider {
    position: absolute;
    bottom: -1.25rem;
    left: 25%;
    right: 25%;
    height: 1px;
    background: rgba(255, 255, 255, 0.15);
  }

  /* 3-column on desktop */
  @media (min-width: 768px) {
    .stats-section {
      padding: 5rem 2rem;
    }

    .stats-list {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      align-items: start;
    }

    /* Vertical dividers between columns */
    .stat-item {
      padding: 0 2.5rem;
    }

    .stat-divider {
      position: absolute;
      top: 10%;
      bottom: 10%;
      right: 0;
      left: auto;
      width: 1px;
      height: auto;
      background: rgba(255, 255, 255, 0.2);
    }
  }

  @keyframes statReveal {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .stat-item {
      animation: none;
      opacity: 1;
    }
  }
</style>
